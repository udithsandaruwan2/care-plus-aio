{
	email {$ACME_EMAIL:ops@localhost}
}

# CADDY_SITE is a hostname (HTTPS + Let's Encrypt) or http://host (plain HTTP).
# Examples:
#   CADDY_SITE=app.careplus.lk
#   CADDY_SITE=http://localhost
{$CADDY_SITE:http://localhost} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}

	# Public research docs. /api/* is denylisted by the existing service worker,
	# so these URLs reach origin even when /docs and /research/* are captured as SPA.
	@pubDocsPage path /api/public-docs /api/public-docs/
	handle @pubDocsPage {
		rewrite * /docs.html
		root * /srv/web
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	handle_path /api/public-docs/* {
		root * /srv/web/research
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}

	@docsPage path /docs /docs/
	handle @docsPage {
		rewrite * /docs.html
		root * /srv/web
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	# API, admin, media, and Gemini Live / Channels WebSockets.
	@backend path /api/* /ws/* /admin* /static/* /media*
	handle @backend {
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			header_up X-Request-ID {http.request.header.X-Request-ID}
		}
	}

	# Research files must not fall through to the SPA. Otherwise a missing PDF
	# is served as index.html and CDNs cache that HTML on the PDF URL.
	@research path /research/*
	handle @research {
		root * /srv/web
		header Cache-Control "public, max-age=3600, must-revalidate"
		file_server
	}

	# Service worker and HTML must revalidate so deploys are not stuck on a CDN HIT.
	@nocache path /sw.js /cp-sw.js /index.html /offline.html /docs.html
	handle @nocache {
		root * /srv/web
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
