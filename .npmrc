# SDK 54+ supports pnpm isolated installs (default). Do not force node-linker=hoisted —
# that collapses React 18 (web) and React 19 (mobile) into one version.
# See https://docs.expo.dev/guides/monorepos/
#
# Prevent optional Expo/RN peers (e.g. from @react-three/fiber) from being
# auto-installed into apps/web and polluting its React 18 type graph.
auto-install-peers=false
